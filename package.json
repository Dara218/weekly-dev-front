{
  "name": "weekly-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:s3",
    "deploy:s3": "aws s3 sync dist/ s3://weekly-dev-front/ --delete --cache-control \"public, max-age=31536000, immutable\" --exclude \"index.html\" && aws s3 cp dist/index.html s3://weekly-dev-front/index.html --cache-control \"public, max-age=0, must-revalidate\"",
    "deploy:invalidate": "aws cloudfront create-invalidation --distribution-id E1F8Q16X31TART --paths \"/*\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.13.2",
    "laravel-echo": "^2.3.7",
    "lodash": "^4.17.23",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "pusher-js": "^8.5.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue-select": "^4.0.0-beta.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5"
  }
}
