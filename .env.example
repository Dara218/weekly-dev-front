# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the frontend.

# API
VITE_API_BASE_URL=
VITE_STORAGE_BUCKET_BASE_URL=

# Laravel Reverb (real-time notifications)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
# Optional — defaults to VITE_REVERB_PORT when unset
VITE_REVERB_WSS_PORT=
